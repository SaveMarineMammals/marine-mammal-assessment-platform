environment              = "staging"
aws_region               = "us-east-1"
domain_name              = ""
web_subdomain            = "staging"
hosted_zone_id           = ""
acm_certificate_arn      = ""
enable_apex_redirect     = false
enable_cdn               = true
github_repository        = "SaveMarineMammals/marine-mammal-assessment-platform"
db_instance_class        = "db.t4g.micro"
db_backup_retention_days = 7

# After bootstrap domain registration + ACM validation:
# domain_name         = "savemarinemammals.com"
# hosted_zone_id      = "Zxxxxxxxxxxxx"          # terraform -chdir=infra/bootstrap output -raw hosted_zone_id
# acm_certificate_arn = "arn:aws:acm:us-east-1:..." # terraform -chdir=infra/bootstrap output -raw acm_certificate_arn
# Site: https://staging.savemarinemammals.com
# Field: https://staging.savemarinemammals.com/field/app

tags = {
  CostCenter = "mmap-staging"
}
