aws_region        = "us-east-1"
github_repository = "SaveMarineMammals/marine-mammal-assessment-platform"

tags = {
  CostCenter = "mmap-bootstrap"
}

# --- Public domain (Route 53 Domains + shared ACM) ---
# Registration is billed (~$16/yr for .com) and non-refundable.
# Set enable_public_domain = true and fill domain_contact before apply.
# Do not commit real contact PII — keep it in local terraform.tfvars or CI secrets.

enable_public_domain = false
public_domain        = "savemarinemammals.com"

